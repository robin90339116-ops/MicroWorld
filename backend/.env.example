# MicroWorld backend runtime config
SMALLWORLD_BACKEND_HOST=0.0.0.0
SMALLWORLD_BACKEND_PORT=8787
SMALLWORLD_BACKEND_VERSION=0.1.0-safety

# Local dev can keep this as "*". In production set the app/web origin explicitly.
SMALLWORLD_CORS_ORIGIN=*

# Local JSON data file. For Docker/cloud, use a persistent path such as /data/smallworld-data.json.
SMALLWORLD_DATA_FILE=./data.json

# Future cloud migration targets. These are intentionally not used by module 0 yet.
SMALLWORLD_DATABASE_URL=
SMALLWORLD_REDIS_URL=
SMALLWORLD_COS_BUCKET=
SMALLWORLD_COS_REGION=
SMALLWORLD_HUAWEI_PROJECT_ID=
