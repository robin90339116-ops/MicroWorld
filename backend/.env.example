# MicroWorld backend runtime config
# Node.js 22: npm run start:example 或复制到 .env 后 npm run start:local。
# 环境变量优先于文件。真机局域网测试才显式改为 0.0.0.0，并限制防火墙来源。
SMALLWORLD_BACKEND_HOST=127.0.0.1
SMALLWORLD_BACKEND_PORT=8787
SMALLWORLD_BACKEND_VERSION=0.1.0-safety

# Local dev can keep this as "*". In production set the app/web origin explicitly.
SMALLWORLD_CORS_ORIGIN=*

# 本地 JSON 数据文件(file 模式)。Docker/云上用持久路径,如 /data/smallworld-data.json。
# 一旦设置了 SMALLWORLD_DATABASE_URL,此文件不再承载业务数据。
SMALLWORLD_DATA_FILE=./data.json

# ---- 华为云数据库(登录注册 + 业务数据存储)----
# 设置后后端自动切换到数据库持久化(见 src/shared/store.js)。
# 当前目标为 PostgreSQL / RDS for PostgreSQL；openGauss 兼容性需单独实测。
# 格式:postgres://用户名:密码@主机:端口/数据库名
# 例:  postgres://root:YourPassword@192.168.0.10:5432/microworld
SMALLWORLD_DATABASE_URL=

# 存放整份应用状态的表名(默认 microworld_state,自动建表)。
SMALLWORLD_DATABASE_TABLE=microworld_state

# SSL:留空或 verify-full=加密并校验证书。
# 设为 disable=关闭 SSL(仅本地明文 Postgres 测试用);
# 私有 CA 须将证书内容放入 SMALLWORLD_DATABASE_CA；不提供静默跳过校验模式。
SMALLWORLD_DATABASE_SSL=
SMALLWORLD_DATABASE_CA=

# 连接池大小(默认 4)。
SMALLWORLD_DATABASE_POOL=4

# ---- 数字藏品上链(华为云 BCS 联盟链)----
# 默认 certificate:后端自签数字藏品凭证,不接任何链(当前阶段)。
# 设为 huawei-bcs 后走华为云 BCS 铸造(需部署链码并配置下方端点/证书)。
SMALLWORLD_CHAIN_PROVIDER=certificate

# 仅在 SMALLWORLD_CHAIN_PROVIDER=huawei-bcs 时需要:
SMALLWORLD_CHAIN_ENDPOINT=
SMALLWORLD_CHAIN_CHANNEL=microworld-channel
SMALLWORLD_CHAIN_CODE=microworld-collectible
SMALLWORLD_CHAIN_NAME=huawei-bcs
SMALLWORLD_CHAIN_API_KEY=
# Operator-owned merchant account/device allowlist; never commit real registrations.
# No file or invalid file means no merchant terminal is authorized.
SMALLWORLD_MERCHANT_REGISTRY_FILE=
